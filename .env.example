# Bootstrap admin for AuthCrunch local identity store (static user block).
# Password must be a precomputed AuthCrunch hash, not plaintext:
#   bcrypt:<cost>:<bcrypt-hash>
# Generate with authdbctl (from go-authcrunch):
#   authdbctl generate password hash --cost 10
# Example value shape (not a real secret):
#   bcrypt:10:$2a$10$WiU7BR1vqCNnzP5rZltJ5Ow5RspiIgnenCCFGSeMPrFFUhHRpkIhe
AUTHP_ADMIN_USER=
AUTHP_ADMIN_EMAIL=
AUTHP_ADMIN_PASSWORD_HASH=

# Shared secret for signed session cookies. Use a long random string.
JWT_SHARED_KEY=

# Bearer token injected to the AgentMemory viewer after browser login.
# Use a dedicated viewer-proxy secret — never reuse AGENTMEMORY_SECRET / HMAC.
AGENTMEMORY_VIEWER_PROXY_SECRET=

# Public cookie domain for the Railway service
COOKIE_DOMAIN=memory-dashboard.martinjakubik.com

# Private AgentMemory service on Railway
UPSTREAM_URL=http://agentmemory.railway.internal:3113

# Listen port (Railway sets PORT automatically)
PORT=8080
