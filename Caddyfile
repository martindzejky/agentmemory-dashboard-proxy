{
	auto_https off
	admin off

	order authenticate before respond
	order authorize before reverse_proxy

	servers {
		trusted_proxies static private_ranges
	}

	security {
		local identity store localdb {
			realm local
			path /data/users.json
		}

		authentication portal dashboard_portal {
			crypto default token lifetime 86400
			crypto key sign-verify {env.JWT_SHARED_KEY}
			enable identity store localdb
			cookie domain {$COOKIE_DOMAIN}
			ui {
				links {
					"AgentMemory" "/" icon "las la-home"
				}
			}
			transform user {
				match origin local
				action add role authp/user
			}
		}

		authorization policy dashboard_policy {
			set auth url /auth/login
			allow roles authp/admin authp/user
			crypto key verify {env.JWT_SHARED_KEY}
		}
	}
}

:{$PORT} {
	handle /auth* {
		authenticate with dashboard_portal
	}

	handle {
		authorize with dashboard_policy
		reverse_proxy {$UPSTREAM_URL}
	}
}
