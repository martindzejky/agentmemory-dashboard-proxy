{
	auto_https off
	admin off

	order authenticate before respond
	order authorize before reverse_proxy

	servers {
		trusted_proxies static private_ranges
	}

	security {
		local identity store localdb {
			realm local
			path /data/users.json
			user {$AUTHP_ADMIN_USER} {
				email {$AUTHP_ADMIN_EMAIL}
				password "{$AUTHP_ADMIN_PASSWORD_HASH}" overwrite
				roles authp/admin authp/user
			}
		}

		authentication portal dashboard_portal {
			crypto default token lifetime 86400
			crypto key sign-verify {env.JWT_SHARED_KEY}
			enable identity store localdb
			cookie domain {$COOKIE_DOMAIN}
			trust login redirect uri domain exact {$COOKIE_DOMAIN} path prefix /
			trust logout redirect uri domain exact {$COOKIE_DOMAIN} path prefix /
			ui {
				links {
					"AgentMemory" "/" icon "las la-home"
				}
			}
			transform user {
				match origin local
				action add role authp/user
			}
		}

		authorization policy dashboard_policy {
			set auth url /auth/login
			set token sources cookie
			allow roles authp/admin authp/user
			crypto key verify {env.JWT_SHARED_KEY}
		}
	}
}

:{$PORT} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /auth* {
		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}
		authenticate with dashboard_portal
	}

	handle {
		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}
		authorize with dashboard_policy
		reverse_proxy {$UPSTREAM_URL} {
			header_up Authorization "Bearer {env.AGENTMEMORY_VIEWER_PROXY_SECRET}"
		}
	}
}
